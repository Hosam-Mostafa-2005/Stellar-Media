# STELLAR MEDIA — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your authorized credentials.
# DO NOT COMMIT ACTUAL API SECRETS TO VERSION CONTROL.

# 1. Transactional Email Provider (Resend)
# Obtain your API key from https://resend.com/api-keys
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuv

# 2. Designated Recipient Email Address
# All verified consultation inquiries will be delivered to this inbox
CONTACT_RECIPIENT_EMAIL=consultation@stellarmedia.ae

# 3. Verified Sender Identity
# Must be a verified domain on Resend (or onboarding@resend.dev for testing)
CONTACT_SENDER_EMAIL=Stellar Media <inquiries@stellarmedia.ae>

# 4. Server Port (for standalone production server)
PORT=3001
